# EchoReader AI Configuration Environment Template

# API Server Config
PORT=3001
HOST=localhost
NODE_ENV=development
API_URL=https://api.echoreader.ai.stream-in.app
WEB_URL=https://echoreader.ai.stream-in.app

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL="file:./dev.db"

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379"

# JWT Secret for Session Signatures
JWT_SECRET="generate_a_secure_long_random_string_here"

# Auth Providers (Google & GitHub OAuth)
GOOGLE_CLIENT_ID="google-client-id"
GOOGLE_CLIENT_SECRET="google-client-secret"
GITHUB_CLIENT_ID="github-client-id"
GITHUB_CLIENT_SECRET="github-client-secret"

# LLM Providers Configuration
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
OLLAMA_HOST="http://localhost:11434"

# Speech Synthesis (TTS) Keys
AZURE_TTS_KEY="your-azure-cognitive-key"
AZURE_TTS_REGION="eastus"
ELEVENLABS_API_KEY="your-elevenlabs-key"

# Storage Settings (AWS S3)
AWS_ACCESS_KEY_ID="s3-access-key"
AWS_SECRET_ACCESS_KEY="s3-secret-key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="echoreader-assets"

# Search Options
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="meilisearch-master-key"
