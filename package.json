{
  "name": "echoreader-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "EchoReader AI cross-platform document-to-speech reader monorepo",
  "scripts": {
    "dev": "concurrently \"npm run dev -w services/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "db:generate": "prisma generate --schema=database/schema.prisma",
    "db:push": "prisma db push --schema=database/schema.prisma",
    "db:seed": "ts-node database/seed.ts",
    "db:studio": "prisma studio --schema=database/schema.prisma"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.13.0",
    "concurrently": "^9.1.2",
    "prisma": "^6.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0"
  }
}
